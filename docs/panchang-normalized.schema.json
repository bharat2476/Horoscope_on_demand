{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiritualguidance.local/schemas/panchang-normalized.schema.json",
  "title": "Normalized Panchang",
  "description": "Provider-neutral Panchang record for one civil date and one place. Names are stable English identifiers. Display text stays outside this schema until a reviewer approves a translation. This schema does not call a provider.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "query", "convention", "result"],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calendarDate",
        "latitude",
        "longitude",
        "elevationMeters",
        "timeZone",
        "instant",
        "ayanamsa"
      ],
      "properties": {
        "calendarDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Civil date in the stated IANA time zone."
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "elevationMeters": {
          "type": ["number", "null"],
          "description": "Null when the provider or reference ignores elevation."
        },
        "timeZone": {
          "type": "string",
          "minLength": 1,
          "description": "IANA time zone, for example Asia/Kolkata."
        },
        "instant": {
          "type": "string",
          "description": "ISO-8601 instant sent to the provider, including a numeric offset."
        },
        "ayanamsa": {
          "$ref": "#/$defs/ayanamsa"
        },
        "cityId": {
          "type": "string",
          "description": "Optional id from the app place list. The place list has no coordinates, so cityId never replaces latitude and longitude."
        }
      }
    },
    "convention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sunriseLimb", "refraction", "dayBoundary", "monthSystem"],
      "properties": {
        "sunriseLimb": {
          "enum": ["upper-limb", "middle-limb", "unspecified"]
        },
        "refraction": {
          "enum": ["standard", "none", "unspecified"]
        },
        "dayBoundary": {
          "const": "sunrise-to-next-sunrise"
        },
        "monthSystem": {
          "enum": ["amanta", "purnimanta", "both", "unspecified"]
        }
      }
    },
    "result": {
      "oneOf": [
        { "$ref": "#/$defs/okResult" },
        { "$ref": "#/$defs/errorResult" },
        { "$ref": "#/$defs/unavailableResult" }
      ]
    }
  },
  "$defs": {
    "ayanamsa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "enum": ["lahiri", "lahiri-icrc", "raman", "kp", "kp-new", "tropical"]
        },
        "providerCode": {
          "type": ["string", "number", "null"],
          "description": "Provider-specific code, such as Prokerala ayanamsa=1 for Lahiri."
        },
        "arcseconds": {
          "type": ["number", "null"],
          "description": "Numeric ayanamsa at the query instant, when the provider or reference returns it."
        }
      }
    },
    "instant": {
      "type": "string",
      "description": "ISO-8601 date-time with a numeric offset."
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/instant" },
        "end": { "$ref": "#/$defs/instant" }
      }
    },
    "namedInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "start", "end"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "start": { "$ref": "#/$defs/instant" },
        "end": { "$ref": "#/$defs/instant" },
        "paksha": { "enum": ["shukla", "krishna"] },
        "lord": { "type": "string" },
        "pada": { "type": "integer", "minimum": 1, "maximum": 4 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "retrievedAt"],
      "properties": {
        "provider": { "type": "string" },
        "operation": { "type": "string" },
        "retrievedAt": { "$ref": "#/$defs/instant" },
        "providerVersion": {
          "type": ["string", "null"],
          "description": "Provider or calculation version when the response includes one."
        },
        "creditsCharged": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "okResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source",
        "vaara",
        "sunrise",
        "sunset",
        "tithi",
        "nakshatra",
        "yoga",
        "karana"
      ],
      "properties": {
        "status": { "const": "ok" },
        "source": { "$ref": "#/$defs/source" },
        "vaara": { "type": "string" },
        "sunrise": { "$ref": "#/$defs/instant" },
        "sunset": { "$ref": "#/$defs/instant" },
        "moonrise": { "type": ["string", "null"] },
        "moonset": { "type": ["string", "null"] },
        "tithi": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/namedInterval" }
        },
        "nakshatra": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/namedInterval" }
        },
        "yoga": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/namedInterval" }
        },
        "karana": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/namedInterval" }
        },
        "rahuKaal": { "$ref": "#/$defs/interval" },
        "yamaganda": { "$ref": "#/$defs/interval" },
        "gulika": { "$ref": "#/$defs/interval" }
      }
    },
    "errorResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source", "httpStatus"],
      "properties": {
        "status": { "const": "error" },
        "source": { "$ref": "#/$defs/source" },
        "httpStatus": { "type": "integer" },
        "providerCode": { "type": ["string", "null"] },
        "message": { "type": "string" }
      }
    },
    "unavailableResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "const": "unavailable" },
        "reason": { "type": "string" }
      }
    }
  }
}
