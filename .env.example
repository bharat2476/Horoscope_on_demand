# Copy this file to .env for local development. Never commit .env.
# Leave both values empty until a Supabase project exists.
# These are public client values. They are embedded in the Android app.
# Do not add the Supabase service-role key, database password, or any other secret.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
