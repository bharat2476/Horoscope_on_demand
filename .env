# Local `npx expo start` reads a file named .env in this folder.
# An Android EAS build does not read that laptop file.
# Set the same EXPO_PUBLIC_ names in the EAS environment for the build profile.
# Leave the Supabase values empty until a project exists.
# These are public client values. They are embedded in the Android app.
# Do not add the Supabase service-role key, database password, or any other secret.
# development, staging, and production each need their own Supabase project.

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://aailccsfpigkaxwgsuae.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_VBD_byg6ejktLZ6y8JsYZw_W-80F9HF
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFhaWxjY3NmcGlna2F4d2dzdWFlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE5MDU5NTMsImV4cCI6MjEwNzQ4MTk1M30.ALtlUKnPpj4ngxeQErQklc9_AidwRv_MitLZE28kmSs

# Public URL of the trusted session-credential endpoint. Empty disables live video.
# Do not put a LiveKit API secret, webhook secret, or service-role key in this file.
EXPO_PUBLIC_PUJA_SESSION_URL=

# Server only. Set these on the credential and webhook host, never in the Android app.
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=
